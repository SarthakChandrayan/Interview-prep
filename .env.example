# MongoDB connection string. Defaults to a local instance when unset.
MONGODB_URI=mongodb://127.0.0.1:27017/interview-prep

# Optional: enables the AI mock interviewer. Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: which Claude model the interviewer uses (default: claude-sonnet-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: daily caps on AI calls, to protect a public deployment from runaway costs.
# AI_DAILY_LIMIT=300
# AI_PER_USER_DAILY_LIMIT=60
